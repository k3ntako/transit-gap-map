# Secrets
.env

# Python
.venv/
__pycache__/
*.py[cod]

# Data: raw downloads and large intermediates are reproducible via `make fetch`
data/raw/
data/processed/
*.osm.pbf

# Generated web payloads (rebuild with `make all`). Everything in here is
# pipeline output, including palette.json and walk_surface.json, so ignore the
# directory wholesale rather than listing extensions that drift out of date.
web/data/*
!web/data/.gitkeep

# Agent worktrees are checkouts of this repo inside itself, so git offers to
# add them as an embedded repository and `git add -A` picks them up. The rest of
# .claude/ is deliberately not ignored: skills and settings there are source.
.claude/worktrees/

# Terraform: provider downloads and per-machine variable files, which can hold
# an email address. State lives in S3 (see infra/bootstrap), never here. The
# .terraform.lock.hcl provider lock is source and stays tracked.
.terraform/
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*

# macOS
.DS_Store
